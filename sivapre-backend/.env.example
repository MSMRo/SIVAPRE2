# ==========================================
# SIVAPRE Backend - Variables de Entorno
# ==========================================

# 1. Base de datos PostgreSQL (Local en PC o Docker)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/sivapre_db

# Para ejecución dentro de docker-compose:
# DATABASE_URL=postgresql://postgres:admin@db:5432/sivapre_db

# 2. Base de datos PostgreSQL (Producción en SUPABASE)
# Reemplazar con el Connection String de Supabase (Settings -> Database -> Connection string URI)
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# 3. Supabase Storage (Opcional - para almacenar fotos en la nube en producción)
# Si se configuran, las fotos van directo al bucket de Supabase. Si se omiten, se guardan en ./uploads
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=[TU_SUPABASE_SERVICE_ROLE_KEY_O_ANON_KEY]
SUPABASE_BUCKET=reportes-fotos

# 4. Seguridad y JWT
SECRET_KEY=sivapre_super_secret_jwt_key_2025_upch_utec_minsa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
